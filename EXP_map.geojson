
import json
import math

INPUT = "experiences.geojson"
OUTPUT = "experiences_fixed.geojson"

def to_wgs84(x, y):
    lon = x / 20037508.34 * 180
    lat = y / 20037508.34 * 180
    lat = 180 / math.pi * (
        2 * math.atan(math.exp(lat * math.pi / 180)) - math.pi / 2
    )
    return [lon, lat]

with open(INPUT, "r", encoding="utf-8") as f:
    data = json.load(f)

features = []

for feature in data["features"]:
    props = feature["properties"].copy()
    x, y = feature["geometry"]["coordinates"]

    # Convert coordinates from EPSG:3857 to EPSG:4326
    feature["geometry"]["coordinates"] = to_wgs84(x, y)

    # Remove unnecessary QGIS metadata
    props.pop("path", None)
    props.pop("layer", None)
    props.pop("featured", None)
    props.pop("fid", None)

    # Correct verified information
    if props.get("city") == "Kigali":
        props["period"] = "May 2025 – August 2026"

    if props.get("city") == "Dakar":
        props["role"] = (
            "Technical & Data Analyst – "
            "Food Security and Livelihoods (FSL)"
        )

    if props.get("city") == "Madrid":
        props["period"] = props["period"].replace("-", "–")

    if props.get("city") == "Rome":
        props["period"] = "September 2019 – December 2022"

    feature["properties"] = props
    features.append(feature)

# Create one Madrid marker with two separate experiences
madrid = [f for f in features if f["properties"].get("city") == "Madrid"]
others = [f for f in features if f["properties"].get("city") != "Madrid"]

if len(madrid) == 2:
    madrid_feature = madrid[0].copy()
    madrid_feature["properties"] = {
        "city": "Madrid",
        "country": "Spain",
        "category": "Professional experience",
        "experiences": [
            f["properties"] for f in madrid
        ]
    }
    features = others + [madrid_feature]

data["features"] = features
data.pop("crs", None)

with open(OUTPUT, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)

print(f"GeoJSON corretto: {OUTPUT}")
print(f"Numero di marker: {len(features)}")

